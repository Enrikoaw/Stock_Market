# ==============================================================================
# SMARTFLOW IDX - CONFIGURATION & BROKER API CREDENTIALS (.env)
# ------------------------------------------------------------------------------
# Panduan:
# 1. Salin file ini menjadi '.env' di direktori root aplikasi:
#    cp .env.example .env
# 2. Masukkan token atau API Key Invezgo Anda pada variabel INVEZGO_API_KEY.
# 3. File '.env' sudah terdaftar di .gitignore, aman dan TIDAK AKAN ter-push ke GitHub.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. INVEZGO BROKERSUM API (AKTIF / UTAMA)
# ------------------------------------------------------------------------------
# Masukkan API Key / Bearer Token dari Invezgo Anda di bawah ini:
INVEZGO_API_KEY=your_invezgo_api_key_or_token_here

# Provider broker yang aktif: 'invezgo' | 'stockbit' | 'goapi' | 'mock'
BROKER_API_PROVIDER=invezgo

# ------------------------------------------------------------------------------
# 2. PENGATURAN SMART FUNNELING (TWO-STAGE SELECTION)
# ------------------------------------------------------------------------------
# Maksimal kandidat Stage 1 yang diuji X-Ray ke Invezgo API per hari.
# Rekomendasi: 25 - 30 saham (Sangat hemat limit, hanya memakan ~25-30 request dari 250 req/menit).
BROKER_MAX_CANDIDATES=30

# Jeda waktu (delay) antar-request ke API Invezgo dalam milidetik (ms).
# Nilai 300 ms = ~3 request per detik, sangat stabil & aman dari blokir.
BROKER_FETCH_DELAY_MS=300

# ------------------------------------------------------------------------------
# 3. PROVIDER CADANGAN (OPSIONAL / JIKA INGIN BERGANTI)
# ------------------------------------------------------------------------------
STOCKBIT_BEARER_TOKEN=
GOAPI_KEY=

# ------------------------------------------------------------------------------
# 4. ALERT BERITA POSITIF EMITEN KE HP (pilih Telegram dan/atau ntfy)
# ------------------------------------------------------------------------------
# Telegram: buat bot via @BotFather -> token; kirim pesan ke bot, lalu ambil chat id via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# ntfy (tanpa akun): install app ntfy di HP, subscribe ke topic rahasia buatan Anda
NTFY_TOPIC=
NEWS_ALERT_ENABLED=true
